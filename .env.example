# KaiCorp Account — variables de entorno.
#
# Compose carga `.env`; para el binario exporta las variables. Sin las de
# GoTrue y la base la aplicación NO arranca: una app de cuenta a medio
# configurar es una puerta abierta a medias.

# La dirección que ve el navegador. Decide los enlaces absolutos y el Secure
# de las cookies.
ACCOUNT_PUBLIC_URL=https://account.example.com

# La API de GoTrue, con su prefijo /auth/v1. La base INTERNA: dentro de Docker
# 127.0.0.1 es el contenedor; usa el nombre de la pasarela en su red.
ACCOUNT_GOTRUE_URL=http://supabase-kaicorplabs-gw/auth/v1

# Clave anónima (role anon) y clave de servicio (role service_role) de esa
# instancia. La de servicio sólo se usa para bloquear y borrar cuentas.
ACCOUNT_ANON_KEY=
ACCOUNT_SERVICE_KEY=

# El Postgres de la instancia, con el rol `account` que crea db/bootstrap.sql.
ACCOUNT_DATABASE_URL=postgres://account:CAMBIAME@supabase-kaicorplabs-db:5432/postgres

# 32 bytes en hex: cifra los tokens en reposo y firma el CSRF. Cambiarla cierra
# todas las sesiones.
#   openssl rand -hex 32
ACCOUNT_SESSION_KEY=

# Vida máxima de una sesión de esta app (1-24 h; por defecto 12).
#ACCOUNT_SESSION_TTL_HOURS=12

# Membresía que abre /admin (por defecto account-admin).
#ACCOUNT_ADMIN_GROUP=account-admin

# Sólo para pruebas por http sin TLS delante.
#ACCOUNT_INSECURE_COOKIES=1
