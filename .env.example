# KaiCorp Account — variables de entorno.
#
# Compose carga `.env`; para el binario exporta las variables. Sin las de
# GoTrue y la base la aplicación NO arranca: una app de cuenta a medio
# configurar es una puerta abierta a medias.

# La dirección que ve el navegador. Decide los enlaces absolutos y el Secure
# de las cookies.
ACCOUNT_PUBLIC_URL=https://account.example.com

# Por defecto el límite usa el par TCP, ignorando cabeceras de IP.
# Sólo detrás de un proxy que SOBRESCRIBE la cabecera elegida: configura ambas
# variables con los CIDR de sus pares inmediatos y una única cabecera.
# No confíes en redes enteras si otros clientes pueden alcanzar el listener.
#ACCOUNT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
#ACCOUNT_CLIENT_IP_HEADER=CF-Connecting-IP

# La API de GoTrue, con su prefijo /auth/v1. Siempre HTTPS: la red interna no
# protege contraseñas ni la clave de servicio. El certificado debe cubrir este
# nombre y encadenar a una CA del sistema (instala la CA privada si hace falta).
ACCOUNT_GOTRUE_URL=https://gotrue-gateway/auth/v1

# Excepción sólo para desarrollo local: exige una IP literal 127.0.0.0/8 o
# [::1]. No admite localhost, redes Docker, LAN ni direcciones privadas.
#ACCOUNT_GOTRUE_INSECURE_HTTP=1

# Clave anónima (role anon) y clave de servicio (role service_role) de esa
# instancia. La de servicio sólo se usa para bloquear y borrar cuentas.
ACCOUNT_ANON_KEY=
ACCOUNT_SERVICE_KEY=

# Copia también GOTRUE_MAILER_OTP_EXP al entorno de la app: el arranque compara
# ambos valores. La app relee la fecha de emisión antes de canjear un enlace.
# Como defensa adicional, no admite capacidades de correo de más de un día.
GOTRUE_MAILER_OTP_EXP=86400
ACCOUNT_EMAIL_LINK_TTL_SECONDS=86400

# El Postgres de la instancia con el rol DML `account`. No posee el esquema ni
# puede crear o reemplazar las relaciones que leen los hooks privilegiados.
ACCOUNT_DATABASE_URL=postgres://account:CAMBIAME@db:5432/postgres

# Sólo para ejecutar `account migrar` durante un despliegue. No guardes esta
# variable en el entorno del servidor ni en el fichero que carga el contenedor.
#ACCOUNT_MIGRATION_DATABASE_URL=postgres://account_migrator:CAMBIAME@db:5432/postgres

# 32 bytes en hex: cifra los tokens en reposo y firma el CSRF. Cambiarla cierra
# todas las sesiones.
#   openssl rand -hex 32
ACCOUNT_SESSION_KEY=

# Vida máxima de una sesión de esta app (1-24 h; por defecto 12).
#ACCOUNT_SESSION_TTL_HOURS=12

# Membresía que abre /admin (por defecto account-admin).
#ACCOUNT_ADMIN_GROUP=account-admin

# Sólo para desarrollo local con ACCOUNT_PUBLIC_URL=http://127.0.0.1:puerto
# (o [::1]). Se rechaza con HTTPS, nombres de host y direcciones remotas.
#ACCOUNT_INSECURE_COOKIES=1
